    {
      "id": "pii-phone-de",
      "description": "German Phone Number",
      "regex": "\\b0[1-9]\\d{6,11}\\b",
      "category": "pii",
      "requireContext": true,
      "contextWords": ["telefon", "tel", "handy", "mobil", "phone", "fax"]
