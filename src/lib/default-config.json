    {
      "id": "pii-steuer-id-de",
      "description": "German Steuer-Identifikationsnummer",
      "regex": "\\b[1-9]\\d{10}\\b",
      "category": "pii",
      "validate": "steuer-id-de"
    },
    {
      "id": "pii-dni-nie-es",
      "description": "Spanish DNI / NIE",
