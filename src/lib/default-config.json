    {
      "id": "pii-phone-es",
      "description": "Spanish Phone Number",
      "regex": "\\b[67]\\d{8}\\b",
      "category": "pii",
      "requireContext": true,
      "contextWords": [
        "tel\u00e9fono",
        "telefono",
        "tel",
        "m\u00f3vil",
        "movil",
        "phone",
        "fax"
      ]
    },
    {
      "id": "pii-postal-code",
      "description": "Postal Code (US ZIP / EU / KR)",
      "regex": "\\b\\d{5}(?:-\\d{4})?\\b",
      "category": "pii",
      "requireContext": true,
      "contextWords": [
        "zip",
        "postal",
        "postale",
        "postcode",
        "plz",
        "postleitzahl",
        "\uc6b0\ud3b8\ubc88\ud638",
