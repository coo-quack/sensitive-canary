      "requireContext": true,
      "contextWords": [
        "\u7535\u8bdd",
        "\u624b\u673a",
        "tel",
        "phone",
        "mobile",
        "fax"
      ]
    },
    {
      "id": "pii-postal-cn",
      "description": "Chinese Postal Code",
      "regex": "\\b[1-9]\\d{5}\\b",
      "category": "pii",
      "requireContext": true,
      "contextWords": [
        "\u90ae\u7f16",
        "\u90ae\u653f\u7f16\u7801",
        "postal",
        "postcode",
        "zip"
      ]
